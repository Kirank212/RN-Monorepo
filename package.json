{
  "name": "rn-monorepo",
  "version": "1.0.0",
  "description": "React Native Monorepo with shared packages and multiple apps",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*",
      "apps/*"
    ]
  },
  "scripts": {
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf node_modules && find . -name node_modules -type d -prune -exec rm -rf {} +"
  },
  "devDependencies": {
    "@react-native-community/cli": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.50.0",
    "typescript": "^5.2.0"
  },
  "engines": {
    "node": ">= 20",
    "npm": ">= 7.0.0"
  },
  "dependencies": {
    "react": "19.1.0",
    "react-native": "0.81.5"
  },
  "overrides": {
    "@types/react": "^19.1.0"
  }
}
